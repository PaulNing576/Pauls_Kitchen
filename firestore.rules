rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    function onlyChanges(allowedFields) {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(allowedFields);
    }

    // ---------------- waitlist ----------------
    // Writes go through the submitWaitlist Cloud Function (rate-limited).
    // Only admins may read, update, or delete.
    match /waitlist/{id} {

      // Waitlist entries are created through the submitWaitlist Cloud Function
      // (Admin SDK bypasses rules). Direct client writes are not allowed.
      allow create: if isAdmin();

      allow read, update, delete: if isAdmin();
    }

    // ---------------- codes ----------------
    // Anyone can read (needed for customers to validate a code at checkout).
    // Only admins create or delete.
    // Customers may update ONLY to flip `used` to true at checkout.
    match /codes/{id} {

      allow read: if true;
      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (onlyChanges(['used'])
            && request.resource.data.used == true);
    }

    // ---------------- orders ----------------
    // Orders are created through the confirmOrder Cloud Function (Admin SDK).
    // Only admins read or update.
    match /orders/{id} {

      allow create: if isAdmin();

      allow read, update, delete: if isAdmin();
    }

    // ---------------- mail_logs ----------------
    // Written by Cloud Functions (admin SDK bypasses rules).
    // No client-side writes are ever allowed.
    match /mail_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
